{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile storing communication preferences and Danish municipality (Kommune)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth user ID" },
        "displayName": { "type": "string", "maxLength": 100, "description": "Display name of the parent" },
        "email": { "type": "string", "format": "email", "description": "Account email address" },
        "preferredLanguage": { "type": "string", "maxLength": 10, "description": "Preferred interface and translation language code (e.g., en, da, ar, uk, tr)" },
        "kommune": { "type": "string", "maxLength": 80, "description": "Danish municipality name (e.g., København, Aarhus, Albertslund)" },
        "bio": { "type": "string", "maxLength": 500, "description": "Optional parent bio or note on children's ages/needs" },
        "createdAt": { "type": "string", "description": "ISO timestamp of profile creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["uid", "displayName", "email", "preferredLanguage", "kommune"]
    },
    "ForumPost": {
      "title": "ForumPost",
      "description": "Community discussion post across specific categories like PPR, School, or Local Meetups",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique post identifier" },
        "title": { "type": "string", "minLength": 3, "maxLength": 200, "description": "Post title" },
        "content": { "type": "string", "minLength": 5, "maxLength": 5000, "description": "Body text of the post" },
        "category": { "type": "string", "enum": ["ppr_viso", "school_education", "sensory_places", "local_meetups"], "description": "Forum discussion channel category" },
        "authorId": { "type": "string", "description": "Author user ID" },
        "authorName": { "type": "string", "maxLength": 100, "description": "Author display name" },
        "authorKommune": { "type": "string", "maxLength": 80, "description": "Author's Danish Kommune" },
        "authorLanguage": { "type": "string", "maxLength": 10, "description": "Original language written in" },
        "likesCount": { "type": "number", "description": "Count of helpful/like reactions" },
        "commentsCount": { "type": "number", "description": "Number of comments on this post" },
        "translations": { "type": "object", "description": "Map of target language codes to translated text generated by firestore-translate-text extension" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["title", "content", "category", "authorId", "authorName", "authorKommune", "createdAt"]
    },
    "ForumComment": {
      "title": "ForumComment",
      "description": "Comment or reply on a community discussion post",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique comment identifier" },
        "postId": { "type": "string", "description": "Reference to parent post" },
        "content": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "Comment text" },
        "authorId": { "type": "string", "description": "Comment author user ID" },
        "authorName": { "type": "string", "maxLength": 100, "description": "Author display name" },
        "authorKommune": { "type": "string", "maxLength": 80, "description": "Author municipality" },
        "createdAt": { "type": "string", "description": "ISO timestamp of comment" }
      },
      "required": ["postId", "content", "authorId", "authorName", "createdAt"]
    },
    "CommunityEvent": {
      "title": "CommunityEvent",
      "description": "Autism-friendly meetup, low-sensory activity or community gathering in Denmark",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique event identifier" },
        "title": { "type": "string", "minLength": 3, "maxLength": 150, "description": "Event title" },
        "description": { "type": "string", "maxLength": 3000, "description": "Event details, sensory expectations" },
        "address": { "type": "string", "maxLength": 200, "description": "Street address and city/postal code" },
        "kommune": { "type": "string", "maxLength": 80, "description": "Kommune in Denmark" },
        "latitude": { "type": "number", "description": "Geographical latitude in Denmark (approx 54.5 to 57.8)" },
        "longitude": { "type": "number", "description": "Geographical longitude in Denmark (approx 8.0 to 15.2)" },
        "dateTime": { "type": "string", "description": "Event date and time (ISO or formatted string)" },
        "isSunflowerLanyardFriendly": { "type": "boolean", "description": "Whether venue staff recognize Solsikkesnoren (Sunflower Lanyard)" },
        "category": { "type": "string", "enum": ["meetup", "sensory_place", "workshop", "quiet_hour"], "description": "Event/Place classification" },
        "sensoryNotes": { "type": "string", "maxLength": 500, "description": "Sensory accommodation notes (e.g. low noise, dimmed lights, quiet break room)" },
        "createdBy": { "type": "string", "description": "Creator user ID" },
        "createdByName": { "type": "string", "maxLength": 100, "description": "Name of host or submitter" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["title", "address", "kommune", "dateTime", "isSunflowerLanyardFriendly", "createdBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Collection of user profiles containing Kommune and language preferences"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/ForumPost" },
      "description": "Forum discussion threads categorized by special needs topics in Denmark"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/ForumComment" },
      "description": "Subcollection of comments attached to a specific forum post"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/CommunityEvent" },
      "description": "Events and autism-friendly places with coordinates for the map"
    }
  }
}
